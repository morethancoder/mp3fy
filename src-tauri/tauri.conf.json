{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "mp3fy",
	"version": "0.5.0",
	"identifier": "com.morethancoder.mp3fy",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "mp3fy",
				"width": 960,
				"height": 720,
				"minWidth": 360,
				"minHeight": 600
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": [
					"$DOWNLOAD/mp3fy/**",
					"$HOME/mp3fy/**",
					"/storage/emulated/*/Music/mp3fy/**",
					"/storage/emulated/*/Movies/mp3fy/**"
				]
			}
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": [
					"mp3fy"
				]
			},
			"mobile": [
				{
					"scheme": [
						"mp3fy"
					]
				}
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
